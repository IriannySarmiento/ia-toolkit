{
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx wrangler deploy --dry-run:*)",
      "Bash(curl:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Read(./backend/.dev.vars)",
      "Read(./frontend/.env.local)",
      "Bash(npx wrangler delete:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(npx vercel remove:*)",
      "Bash(npx vercel rm:*)",
      "Bash(git push --force:*)"
    ]
  }
}
